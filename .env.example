# DEV-ONLY values for local development. Never use them on a server reachable from the internet.

POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_dev_only
POSTGRES_DB=booking
POSTGRES_PORT=5432

# Used by Prisma and the API when they run on the host (week 1)
DATABASE_URL=postgresql://booking:booking_dev_only@localhost:5432/booking?schema=public

NODE_ENV=development
API_PORT=3001
# How long a pending booking request holds its dates (24 h)
PENDING_TTL_MINUTES=1440
WEB_PORT=3000
