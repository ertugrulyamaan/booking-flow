{
  "name": "booking-flow",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @booking-flow/shared build && pnpm -r run typecheck",
    "test:e2e": "pnpm --filter @booking-flow/shared build && pnpm --filter @booking-flow/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
